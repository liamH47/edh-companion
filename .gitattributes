# Normalize line endings to LF everywhere, in the repo *and* in the working tree.
#
# Not just tidiness: `frontend/scripts/gen-tokens.mjs --check` compares the generated
# token CSS against the file on disk byte-for-byte. Without this, a Windows checkout
# (core.autocrlf=true) gets CRLF, the generator emits LF, and `npm run tokens:check`
# fails locally while passing on Linux CI -- a check whose result depends on the
# developer's OS is worse than no check.
* text=auto eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.woff binary
*.woff2 binary

{
  "name": "mtg-calc",
  "private": true,
  "description": "Repo root. Holds the workspace definition and the end-to-end suite, which tests the built artifact rather than any one package.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @mtg/web",
    "dev": "npm run dev -w @mtg/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "oxlint": "^1.71.0"
  }
}
